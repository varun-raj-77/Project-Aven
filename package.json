{
  "name": "aven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aven experiment foundation and AVEN-002 shared contracts",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit && pnpm --filter @aven/contracts typecheck",
    "experiment:check": "node tooling/scripts/check-experiment.ts",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm experiment:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
